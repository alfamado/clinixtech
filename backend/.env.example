# Server
PORT=4000
NODE_ENV=production

# Comma-separated list of allowed origins for CORS (your deployed frontend domains)
ALLOWED_ORIGINS=https://clinixtech.org,https://www.clinixtech.org

# Resend (https://resend.com) — used to send contact-form emails
RESEND_API_KEY=re_your_api_key_here
CONTACT_FROM_EMAIL=ClinixTech Website <notifications@clinixtech.com>
CONTACT_TO_EMAIL=clinixtechsolutions@gmail.com

# Rate limiting
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5
